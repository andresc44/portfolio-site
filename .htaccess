# BEGIN LSCACHE
## LITESPEED WP CACHE PLUGIN - Do not edit the contents of this block! ##
<IfModule mod_rewrite.c>
RewriteEngine on
RewriteRule litespeed/debug/.*\.log$ - [F,L]
RewriteRule (^|/)\.litespeed_conf\. - [F,L]
</IfModule>
<IfModule LiteSpeed>
CacheLookup on
RewriteRule .* - [E=Cache-Control:no-autoflush]

### marker ASYNC start ###
RewriteCond %{REQUEST_URI} /wp-admin/admin-ajax\.php
RewriteCond %{QUERY_STRING} action=async_litespeed
RewriteRule .* - [E=noabort:1]
### marker ASYNC end ###

### marker REST AUTH start ###
RewriteCond %{HTTP:Authorization} !^$
RewriteCond %{REQUEST_URI} /wp\-json(?:/|$) [OR]
RewriteCond %{QUERY_STRING} (^|&)rest_route=
RewriteRule .* - [E=Cache-Control:no-cache]
### marker REST AUTH end ###

### marker POSTPASS start ###
RewriteCond %{HTTP_COOKIE} (^|;\s*)wp-postpass_31aa8f521117254e507ee4d00ce2e80e=
RewriteRule .* - [E=Cache-Control:no-cache]
### marker POSTPASS end ###

### marker WEBP start ###
RewriteCond %{HTTP_ACCEPT} image/webp [OR]
RewriteCond %{HTTP_USER_AGENT} (chrome-lighthouse|googlebot|page\ speed) [NC,OR]
RewriteCond %{HTTP_USER_AGENT} iPhone\ OS\ (1[4-9]|[2-9][0-9]|[1-9][0-9]{2,})_ [NC,OR]
RewriteCond %{HTTP_USER_AGENT} Macintosh.*Version/((1[7-9]|[2-9][0-9]|[1-9][0-9]{2,})|16\.([4-9]|[1-9][0-9])) [NC,OR]
RewriteCond %{HTTP_USER_AGENT} Firefox/(6[5-9]|[7-9][0-9]|[1-9][0-9]{2,}) [NC]
RewriteRule .* - [E=Cache-Control:vary=%{ENV:LSCACHE_VARY_VALUE}+webp]
### marker WEBP end ###

### marker DROPQS start ###
CacheKeyModify -qs:fbclid
CacheKeyModify -qs:gclid
CacheKeyModify -qs:utm*
CacheKeyModify -qs:_ga
### marker DROPQS end ###

</IfModule>
## LITESPEED WP CACHE PLUGIN - Do not edit the contents of this block! ##
# END LSCACHE
# BEGIN NON_LSCACHE
## LITESPEED WP CACHE PLUGIN - Do not edit the contents of this block! ##
## LITESPEED WP CACHE PLUGIN - Do not edit the contents of this block! ##
# END NON_LSCACHE
# BEGIN WordPress
# The rules between "BEGIN WordPress" and "END WordPress" are dynamically generated by WordPress.
# Local runs nginx and never reads this file; it is here so that, if a transfer carries this
# .htaccess onto the live LiteSpeed server, pretty permalinks keep working.
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteBase /
RewriteRule ^index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]
</IfModule>
# END WordPress
